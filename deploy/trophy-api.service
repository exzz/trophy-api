# /etc/systemd/system/trophy-api.service
# Vu la contrainte "une seule connexion HFSQL par process", on redémarre
# automatiquement : si la connexion est perdue, un process neuf repart proprement.
[Unit]
Description=API Trophy (lecture seule)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=exz
WorkingDirectory=/home/exz/local/trophy
# Identifiants HFSQL + api_key dans settings.json (root-only, chmod 600).
Environment=TROPHY_SETTINGS=/etc/trophy/settings.json
ExecStart=/home/exz/local/trophy/.venv/bin/uvicorn api.app:app --host 127.0.0.1 --port 8333
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
