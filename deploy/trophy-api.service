# /etc/systemd/system/trophy-api.service
# Vu la contrainte "une seule connexion HFSQL par process", on redémarre
# automatiquement : si la connexion est perdue, un process neuf repart proprement.
[Unit]
Description=API Trophy (lecture seule)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=exz
WorkingDirectory=/home/exz/local/trophy
# Secrets dans un fichier root-only (chmod 600) : TROPHY_UID, TROPHY_PWD, TROPHY_API_KEY
EnvironmentFile=/etc/trophy-api.env
ExecStart=/home/exz/local/trophy/api/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
